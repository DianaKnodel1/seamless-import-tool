# Konfiguration für scripts/backup-orchestrator.sh (läuft auf dem Backup-Server)
# Kopieren nach scripts/backup-orchestrator.env und Werte eintragen.

# Lokales Zielverzeichnis auf dem Backup-Server (muss existieren / beschreibbar sein)
BACKUP_DIR=/var/backups/portal

# Server mit der Supabase-Datenbank (Backend-Server)
DB_HOST=123.123.123.11
DB_CONTAINER=supabase-db

# Weitere Produktions-Server (optional, leer lassen wenn nicht vorhanden)
SERVER_PORTAL_HOST=123.123.123.10
SERVER_LANDING_HOST=123.123.123.12
SERVER_BOT_HOST=123.123.123.13
SERVER_WEBID_HOST=123.123.123.14

# Aufbewahrung
BACKUP_RETENTION_DAYS=14

# Konfiguration für scripts/backup.sh und scripts/restore.sh
# Kopieren nach scripts/backup.env und Werte eintragen.
# scripts/backup.env sollte NICHT ins Git committed werden.

# IP oder Hostname des dedizierten Backup-Servers
BACKUP_HOST=123.123.123.123

# SSH-User auf dem Backup-Server (wird von setup-backup-server.sh angelegt)
BACKUP_USER=backup

# Zielverzeichnis auf dem Backup-Server (muss für BACKUP_USER beschreibbar sein)
BACKUP_DIR=/var/backups/portal

# Wie viele Tage tägliche Backups aufbewahrt werden (ältere werden gelöscht)
BACKUP_RETENTION_DAYS=14

# Prefix der Archiv-Dateien
BACKUP_PREFIX=portal

# Lokale Pfade auf dem Server, der gesichert wird
PROJECT_DIR=/opt/apps/portal
SUPABASE_DIR=/opt/supabase
DB_CONTAINER=supabase-db

# Optional: Verschlüsselung mit age (https://age-encryption.org).
# Schlüssel generieren:  age-keygen -o key.txt
# Den öffentlichen Schlüssel (beginnt mit age1...) hier eintragen.
# Der private Schlüssel gehört in deinen Passwortmanager und wird nur beim Restore gebraucht.
AGE_PUBLIC_KEY=age1...
